{
  "apiVersion": 1,
  "id": "canvas",
  "name": "canvas",
  "version": "0.0.5",
  "minAppVersion": "0.1.16",
  "description": "Blabla canvas surface extracted as a local web plugin.",
  "author": {
    "name": "Blabla"
  },
  "runtime": "local-web",
  "activation": {
    "events": [
      "onSurface:canvas"
    ]
  },
  "permissions": {
    "documentAttachments": [
      "read",
      "write"
    ],
    "documentMetadata": [
      "thumbnail:write",
      "title:write"
    ],
    "fileReferences": [
      "import",
      "read",
      "watch",
      "open",
      "reveal"
    ],
    "sourceText": [
      "read",
      "write"
    ],
    "surface": [
      "dirty"
    ]
  },
  "contributes": {
    "dropProviders": [
      {
        "id": "canvas-page-images",
        "surfaceId": "canvas",
        "title": "Page images",
        "accepts": {
          "kinds": [
            "pdf",
            "presentation"
          ]
        },
        "payload": {
          "kind": "page-images"
        },
        "delivery": {
          "kind": "browser-file-drop"
        },
        "priority": 100
      }
    ],
    "fileHandlers": [
      {
        "id": "canvas-document",
        "surfaceId": "canvas",
        "actions": [
          "create",
          "open",
          "edit"
        ],
        "createContent": "{\n  \"nodes\": [],\n  \"edges\": []\n}\n",
        "documentStorage": "sourceText",
        "extensions": [
          ".canvas"
        ],
        "mimeTypes": [
          "application/json"
        ]
      }
    ],
    "surfaces": [
      {
        "id": "canvas",
        "documentType": "canvas",
        "background": "host-material",
        "hostUi": {
          "fileReferenceShelf": {
            "initialLayoutMode": "icon"
          },
          "newToolbar": {
            "tooltip": "Create Canvas"
          }
        },
        "runtime": "webcontents",
        "staticRoot": "./dist",
        "url": "http://127.0.0.1:{port}/"
      }
    ]
  },
  "interface": {
    "displayName": "Canvas",
    "logo": "./assets/logo.svg",
    "shortDescription": "Standalone Blabla canvas surface.",
    "longDescription": "A local Leafer-based canvas plugin that owns canvas documents, visual nodes, snapping, grouped asset layout, and local persistence while using Host API v1 for documents, file references, source sync, and quick view.",
    "developerName": "Blabla",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "defaultPrompt": [
      "Open the Canvas plugin."
    ]
  }
}
