{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "biome.jsonc",
      "package.json",
      "tsconfig.json",
      "vite.config.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
